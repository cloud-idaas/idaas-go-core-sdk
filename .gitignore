samples/obtain-token/obtain-token
samples/refresh-token/refresh-token
samples/token-exchange/token-exchange

# Go 工作区
go.work
go.work.sum

# 依赖目录（vendor 默认提交，如需忽略请取消注释）
# vendor/

# 本地凭证 / 私钥（防止误提交敏感信息）
*.pem
*.key
client-config.json
.cloud_idaas/
# 环境变量形式的密钥文件（保留 *.example.env 作为模板）
*.env
!*.example.env
credentials.env

# MCP 本地配置（含服务器 URL 和 key，属于个人环境配置）
.mcp.json
# IDE
.vscode/
.idea/*
!.idea/.gitignore
!.idea/idaas-go-core-sdk.iml
!.idea/modules.xml
!.idea/vcs.xml
*.iml.bak

# macOS / Linux 系统文件
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# 日志和临时文件
*.log
*.tmp
*.swp
*.swo
*~

# 内部评审报告，不进入开源仓库
docs/review/
CODE_REVIEW_PLAN.md
CODE_REVIEW_REPORT.md
CODE_REVIEW_REPORT_v2.md
CODE_REVIEW_REPORT_v3.md

# 集成测试的本地环境配置与凭证（真实 endpoint / clientId / 证书 / 密钥），只留在本机
integration/testdata/.local/
# AI code review / 内部评审产物，不进入开源仓库
review-output*/
review-result.json
REVIEW_*.md

# 本地备份与临时文件
*.bak
*.orig
.codegraph/
