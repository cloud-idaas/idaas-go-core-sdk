# 复制到 testdata/.local/credentials.env 后填入真实值：
#   mkdir -p testdata/.local && cp testdata/credentials.env.example testdata/.local/credentials.env
# testdata/.local/ 目录与 *.key/*.pem 都已被 .gitignore 忽略，切勿提交
IDAAS_CLIENT_SECRET=your-client-secret
# 私钥可填 PEM 原文，也可填文件路径（相对路径按测试运行目录 integration/ 解析）
IDAAS_PRIVATE_KEY=testdata/.local/your-client.key
